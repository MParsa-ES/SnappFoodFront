<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="720.0" prefWidth="1024.0" spacing="15.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.snappfoodfront.controller.OrderHistoryController">
    <children>
        <TitledPane animated="true" expanded="true" text="Ongoing Orders">
            <content>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
                    <content>
                        <VBox fx:id="ongoingOrdersContainer" spacing="10.0" style="-fx-background-color: #f4f4f4;">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </content>
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </TitledPane>

        <TitledPane animated="true" expanded="true" text="Past Orders">
            <content>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
                    <content>
                        <VBox fx:id="pastOrdersContainer" spacing="10.0" style="-fx-background-color: #f4f4f4;">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </content>
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </TitledPane>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>