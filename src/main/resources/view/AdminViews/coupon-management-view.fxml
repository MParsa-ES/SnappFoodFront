<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="804.0" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.snappfoodfront.controller.CouponManagementController">
    <top>
        <VBox>
            <children>
                <Label styleClass="dashboard-header" text="Coupon Management">
                    <padding>
                        <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                    </padding>
                </Label>
            </children>
        </VBox>
    </top>
    <center>
        <TableView fx:id="couponsTableView" maxHeight="530.0" minHeight="530.0" prefWidth="774.0" styleClass="modern-table-view" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="codeColumn" prefWidth="120.0" text="Coupon Code" />
                <TableColumn fx:id="typeColumn" prefWidth="100.0" text="Type" />
                <TableColumn fx:id="valueColumn" prefWidth="100.0" text="Value" />
                <TableColumn fx:id="minPriceColumn" prefWidth="120.0" text="Min. Purchase" />
                <TableColumn fx:id="startDateColumn" prefWidth="120.0" text="Start Date" />
                <TableColumn fx:id="endDateColumn" prefWidth="120.0" text="End Date" />
                <TableColumn fx:id="actionsColumn" prefWidth="100.0" text="Actions" />
            </columns>
            <BorderPane.margin>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </BorderPane.margin>
        </TableView>
    </center>
    <bottom>
        <VBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <HBox fx:id="feedbackBox" alignment="CENTER" managed="false" visible="false">
                    <children>
                        <Label fx:id="feedbackLabel" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_RIGHT" minHeight="25.0">
                    <children>
                        <JFXButton fx:id="addCouponButton" buttonType="RAISED" mnemonicParsing="false" onAction="#handleAddCoupon" styleClass="primary-action-button" text="+ Add New Coupon" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
        </VBox>
    </bottom>
</BorderPane>
