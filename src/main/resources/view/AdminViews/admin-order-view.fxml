<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="804.0" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.snappfoodfront.controller.AdminOrderOverviewController">

    <fx:define>
        <ToggleGroup fx:id="statusToggleGroup" />
    </fx:define>

    <top>
        <VBox>
            <children>
                <Label styleClass="dashboard-header" text="Order Overview">
                    <padding>
                        <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                    </padding>
                </Label>
                <VBox spacing="10.0" styleClass="filter-bar">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label styleClass="filter-label" text="Status:" />
                                <ToggleButton mnemonicParsing="false" selected="true" styleClass="filter-button" text="All">
                           <toggleGroup>
                              <ToggleGroup fx:id="statusToggleGroup" />
                           </toggleGroup></ToggleButton>
                                <ToggleButton mnemonicParsing="false" styleClass="filter-button" text="Pending" toggleGroup="$statusToggleGroup" />
                                <ToggleButton mnemonicParsing="false" styleClass="filter-button" text="Accepted" toggleGroup="$statusToggleGroup" />
                                <ToggleButton mnemonicParsing="false" styleClass="filter-button" text="In Transit" toggleGroup="$statusToggleGroup" />
                                <ToggleButton mnemonicParsing="false" styleClass="filter-button" text="Completed" toggleGroup="$statusToggleGroup" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <!-- NEW: TextField for searching by food item name -->
                                <TextField fx:id="searchFoodField" prefWidth="180.0" promptText="Filter by Food Item..." styleClass="styled-textfield" />
                                <TextField fx:id="searchVendorField" prefWidth="180.0" promptText="Filter by Vendor..." styleClass="styled-textfield" />
                                <TextField fx:id="searchCourierField" prefWidth="180.0" promptText="Filter by Courier..." styleClass="styled-textfield" />
                                <TextField fx:id="searchCustomerField" prefWidth="180.0" promptText="Filter by Customer..." styleClass="styled-textfield" />
                                <JFXButton fx:id="filterButton" buttonType="RAISED" minWidth="68.0" mnemonicParsing="false" onAction="#handleFilter" styleClass="primary-action-button" text="Apply" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                    </padding>
                </VBox>
            </children>
        </VBox>
    </top>
    <center>
        <TableView fx:id="ordersTableView" styleClass="modern-table-view" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="orderIdColumn" text="Order ID" />
                <TableColumn fx:id="vendorColumn" text="Vendor" />
                <TableColumn fx:id="customerColumn" prefWidth="130.0" text="Customer" />
                <TableColumn fx:id="courierColumn" prefWidth="130.0" text="Courier" />
                <TableColumn fx:id="priceColumn" prefWidth="100.0" text="Price" />
                <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Status" />
                <TableColumn fx:id="actionsColumn" prefWidth="100.0" text="Actions" />
            </columns>
            <BorderPane.margin>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </BorderPane.margin>
        </TableView>
    </center>
    <bottom>
        <HBox fx:id="feedbackBox" alignment="CENTER" managed="false" visible="false" BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="feedbackLabel" />
            </children>
            <BorderPane.margin>
                <Insets bottom="10.0" left="15" right="15"/>
            </BorderPane.margin>
        </HBox>
    </bottom>
</BorderPane>
