<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="804.0" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.snappfoodfront.controller.TransactionManagementController">
    <top>
        <VBox>
            <children>
                <Label styleClass="dashboard-header" text="Transaction Management">
                    <padding>
                        <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                    </padding>
                </Label>
                <VBox spacing="10.0" styleClass="filter-bar">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <TextField fx:id="searchField" prefWidth="313.0" promptText="Search by Restaurant Name..." styleClass="styled-textfield" />
                        <Region prefWidth="150.0" />
                                <TextField fx:id="searchUserField" prefWidth="300.0" promptText="Search by User Name..." styleClass="styled-textfield" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <Label styleClass="filter-label" text="Method:" />
                                <JFXCheckBox fx:id="walletMethodCheck" text="Wallet" />
                                <JFXCheckBox fx:id="onlineMethodCheck" text="Online" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="filter-label" text="Status:" />
                                <JFXCheckBox fx:id="successStatusCheck" text="Success" />
                                <JFXCheckBox fx:id="failedStatusCheck" text="Failed" />
                                <Region HBox.hgrow="ALWAYS" />
                                <JFXButton fx:id="filterButton" buttonType="RAISED" mnemonicParsing="false" onAction="#handleFilter" styleClass="primary-action-button" text="Apply Filters" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                    </padding>
                </VBox>
            </children>
        </VBox>
    </top>
    <center>
        <TableView fx:id="transactionsTableView" styleClass="modern-table-view" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="100.0" text="Transaction ID" />
                <TableColumn fx:id="orderIdColumn" prefWidth="100.0" text="Order ID" />
                <TableColumn fx:id="userIdColumn" prefWidth="100.0" text="User ID" />
                <TableColumn fx:id="methodColumn" prefWidth="150.0" text="Method" />
                <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Status" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <BorderPane.margin>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </BorderPane.margin>
        </TableView>
    </center>
</BorderPane>
