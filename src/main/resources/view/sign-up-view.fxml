<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>


<GridPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.snappfoodfront.controller.SignUpController">
  <columnConstraints>
    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
  </rowConstraints>
   <children>
      <AnchorPane prefHeight="200.0" prefWidth="200.0" GridPane.columnIndex="1">
         <children>
            <ImageView fitHeight="400.0" fitWidth="320.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/logo.png" />
               </image>
            </ImageView>
         </children>
      </AnchorPane>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0">
         <children>
            <VBox spacing="5.0">
               <children>
                  <Label text="Join us for free!">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label text="Sign up with your Phone" />
               </children>
            </VBox>
            <VBox prefHeight="60.0" prefWidth="220.0" spacing="10.0">
               <children>
                  <TextField fx:id="phoneField" promptText="Phone Number" />
                  <PasswordField fx:id="passwordField" promptText="Password" />
                  <ComboBox fx:id="roleBox" prefHeight="25.0" prefWidth="230.0" promptText="Select Role" />
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#handleContinue" prefHeight="30.0" prefWidth="220.0" styleClass="custom-button" stylesheets="@../css/styles.css" text="Continue">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="DEFAULT" />
               </cursor>
            </Button>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label text="Already have an account?" />
                  <Hyperlink fx:id="loginLink" onAction="#handleLoginLink" text="Login" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</GridPane>
