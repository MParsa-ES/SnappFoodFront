<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.snappfoodfront.controller.WalletTopUpController">
    <children>
        <Label text="Top-up Your Wallet">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <VBox alignment="CENTER" spacing="10.0">
            <children>
                <Label text="Enter Amount (Toman):" />
                <TextField fx:id="amountField" alignment="CENTER" maxWidth="200.0" promptText="e.g., 50,000" />
            </children>
        </VBox>
        <JFXButton fx:id="topUpButton" onAction="#handleTopUp" prefWidth="150.0" style="-fx-background-color: #2ecc71;" text="Top-up" textFill="WHITE" />
        <Label fx:id="statusLabel" />
    </children>
    <padding>
        <Insets top="50.0" />
    </padding>
</VBox>