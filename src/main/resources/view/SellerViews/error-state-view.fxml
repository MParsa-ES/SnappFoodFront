<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox alignment="CENTER" layoutX="300.0" layoutY="72.0" prefHeight="400.0" prefWidth="600.0" spacing="15.0" stylesheets="@../../css/styles.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>
         <children>
            <FontIcon iconColor="#d35400" iconLiteral="fas-exclamation-triangle" iconSize="48" selectionFill="BLACK" />
            <Label styleClass="error-state-headline" text="Opps ! Something Went Wrong" />
            <Label fx:id="errorMessageLabel" alignment="CENTER" styleClass="error-state-subtext" text="Error Message" wrapText="true" />
            <Button fx:id="errorActionButton" mnemonicParsing="false" styleClass="custom-button" text="Retry" />
         </children>
      </VBox>
   </children>
</AnchorPane>
