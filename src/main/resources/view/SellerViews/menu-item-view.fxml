<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="menu-item" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.snappfoodfront.controller.MenuItemController">
    <children>
        <Label fx:id="itemNameLabel" text="Food Item Name" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="removeButton" mnemonicParsing="false" onAction="#handleRemoveItem" styleClass="remove-item-button">
            <graphic>
                <FontIcon iconLiteral="fas-times-circle" />
            </graphic>
        </Button>
    </children>
</HBox>