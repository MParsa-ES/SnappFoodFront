<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefWidth="700.0" spacing="20.0" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.snappfoodfront.controller.RestaurantCreationController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <children>
      <Label text="Create a New Restaurant">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>

      <GridPane hgap="10.0" vgap="15.0">
         <columnConstraints>
            <ColumnConstraints halignment="RIGHT" prefWidth="120.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
            <ColumnConstraints halignment="RIGHT" prefWidth="120.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="70.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
         </rowConstraints>
         <children>
            <Label styleClass="form-label" text="Restaurant Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="nameTextField" promptText="e.g., Pizza Palace" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label styleClass="form-label" text="Contact Phone:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="phoneTextField" promptText="e.g., 09123456789" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <Label styleClass="form-label" text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextArea fx:id="addressTextField" prefHeight="70.0" promptText="Full restaurant address" wrapText="true" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2" />

            <Label styleClass="form-label" text="Additional Fee:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="additionalFeeTextField" promptText="e.g., 1500" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label styleClass="form-label" text="Tax Fee:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <TextField fx:id="taxFeeTextField" promptText="e.g., 500" GridPane.columnIndex="3" GridPane.rowIndex="3" />
         </children>
      </GridPane>

      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Button fx:id="chooseLogoButton" mnemonicParsing="false" onAction="#handleChoosingLogo" styleClass="custom-button" text="Choose Logo" />
            <ImageView fx:id="logoImage" fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" />
            <Label text="Optional: Upload a logo for your restaurant." textFill="#868686" wrapText="true" />
         </children>
      </HBox>

      <HBox fx:id="feedbackBox" alignment="CENTER" visible="false">
         <children>
            <Label fx:id="feedbackLabel" />
         </children>
      </HBox>

      <HBox alignment="CENTER" prefHeight="40.0">
         <children>
            <Button fx:id="createRestaurantButton" disable="true" mnemonicParsing="false" onAction="#handleCreateRestaurant" styleClass="custom-button" text="Create Restaurant" />
         </children>
      </HBox>
   </children>
</VBox>
