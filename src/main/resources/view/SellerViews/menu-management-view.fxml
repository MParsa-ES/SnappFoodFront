<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="720.0" prefWidth="1024.0" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.snappfoodfront.controller.MenuManagementController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-border-color: transparent transparent #e0e0e0 transparent; -fx-border-width: 1;">
            <children>
                <Button fx:id="backButton" mnemonicParsing="false" styleClass="subtle-button" text="Back">
                    <graphic>
                        <FontIcon iconLiteral="fas-arrow-left" />
                    </graphic>
                </Button>
                <Label styleClass="dashboard-header" text="Menu Management" />
            </children>
            <padding>
                <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.4" BorderPane.alignment="CENTER">
            <items>
                <VBox spacing="10.0">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label styleClass="panel-header" text="Food Library" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="createNewFoodButton" mnemonicParsing="false" styleClass="custom-button" text="+ New Food" />
                            </children>
                        </HBox>
                        <ListView fx:id="foodLibraryListView" VBox.vgrow="ALWAYS" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>

                <VBox spacing="10.0">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label styleClass="panel-header" text="Menu Categories" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="createNewCategoryButton" mnemonicParsing="false" styleClass="custom-button" text="+ New Category" />
                            </children>
                        </HBox>
                        <Accordion fx:id="menuAccordion" VBox.vgrow="ALWAYS">
                            <panes>
                                <TitledPane animated="false" text="Iranian">
                                    <content>
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label text="(Your 'Garlic Bread' card will go here)" />
                                            </children>
                                        </VBox>
                                    </content>
                                </TitledPane>
                                <TitledPane animated="false" text="FastFoods">
                                    <content>
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label text="(Your 'Pepperoni Pizza' card will go here)" />
                                            </children>
                                        </VBox>
                                    </content>
                                </TitledPane>
                                <TitledPane animated="false" text="Desserts">
                                    <content>
                                        <Label text="(This category is empty)" />
                                    </content>
                                </TitledPane>
                            </panes>
                        </Accordion>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>
