<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox alignment="CENTER" layoutX="250.0" layoutY="100.0" prefHeight="400.0" prefWidth="600.0" spacing="15.0" stylesheets="@../../css/styles.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <FontIcon iconColor="#f39c12" iconLiteral="fas-rocket" iconSize="48" />
            <Label styleClass="empty-state-headline" text="Let's Get You Started!" />

            <Label fx:id="messageLabel" alignment="TOP_CENTER" styleClass="empty-state-subtext" text="Create your first restaurant to appear on the app and start receiving orders." wrapText="true">
               <font>
                  <Font size="18.0" />
               </font></Label>
            <Button fx:id="actionButton" mnemonicParsing="false" styleClass="custom-button" text="Create Your First Restaurant" />
         </children>
      </VBox>
   </children>
</AnchorPane>
