                           </padding></HBox>
                     </content>
                  </ScrollPane>
                  <VBox fx:id="foodContainer" prefWidth="1024.0" />
               </children>
            </VBox>
         </children>
      </JFXScrollPane>
   </center>
</BorderPane>
