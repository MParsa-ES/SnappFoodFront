                                 <children>
                                    <FontIcon iconColor="#6b6b6b" iconLiteral="fas-map-marker-alt" />
                                    <Label fx:id="addressLabel" styleClass="card-subtitle" text="Restaurant Address" />
                                 </children>
                                 <VBox.margin>
                                    <Insets top="5.0" />
                                 </VBox.margin>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="5.0">
                                 <children>
                                    <FontIcon iconColor="#6b6b6b" iconLiteral="fas-phone-alt" />
                                    <Label fx:id="phoneLabel" styleClass="card-subtitle" text="Restaurant Phone" />
                                 </children>
                              </HBox>
                              <Region VBox.vgrow="ALWAYS" />
                              <HBox alignment="CENTER_RIGHT" spacing="10.0" />
                              <JFXButton buttonType="RAISED" style="-fx-background-color: #ff7600;" text="Add to Favorites" textFill="WHITE">
                                 <graphic>
                                    <FontIcon iconColor="WHITE" iconLiteral="fas-star" />
                                 </graphic>
                                 <ripplerFill>
                                    <RadialGradient centerX="0.5" centerY="0.5" cycleMethod="REFLECT" radius="0.5">
                                       <stops>
                                          <Stop>
                                             <color>
                                                <Color red="1.0" blue="0.9647058844566345" />
                                             </color>
                                          </Stop>
                                          <Stop offset="1.0">
                                             <color>
                                                <Color red="1.0" blue="0.9647058844566345" />
                                             </color>
                                          </Stop>
                                       </stops>
                                    </RadialGradient>
                                 </ripplerFill>
