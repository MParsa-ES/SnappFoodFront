<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.snappfoodfront.controller.RestaurantMainController">
   <top>
      <ToolBar prefHeight="40.0" prefWidth="1024.0" BorderPane.alignment="CENTER">
         <items>
            <Region prefHeight="30.0" prefWidth="300.0" />
            <Region prefHeight="30.0" prefWidth="550.0" />
            <JFXButton fx:id="goBackButton" buttonType="RAISED" contentDisplay="RIGHT" onAction="#goBack" style="-fx-background-color: #ff7600; -fx-text-fill: white;" text="Go Back">
               <graphic>
                  <FontIcon iconColor="WHITE" iconLiteral="fas-arrow-alt-circle-left" />
               </graphic>
               <ripplerFill>
                  <LinearGradient endX="1.0" endY="1.0">
                     <stops>
                        <Stop>
                           <color>
                              <Color green="0.10000000149011612" blue="1.0" />
                           </color>
                        </Stop>
                        <Stop offset="1.0">
                           <color>
                              <Color green="0.8333333134651184" blue="1.0" />
                           </color>
                        </Stop>
                     </stops>
                  </LinearGradient>
               </ripplerFill>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </JFXButton>
            <JFXButton fx:id="logoutButton" buttonType="RAISED" contentDisplay="RIGHT" layoutX="872.0" layoutY="13.0" style="-fx-background-color: #ff7600; -fx-text-fill: white;" text="Logout">
               <graphic>
                  <FontIcon iconColor="WHITE" iconLiteral="fas-sign-out-alt" />
               </graphic>
               <ripplerFill>
                  <LinearGradient endX="1.0" endY="1.0">
                     <stops>
                        <Stop>
                           <color>
                              <Color />
                           </color>
                        </Stop>
                        <Stop offset="1.0">
                           <color>
                              <Color red="1.0" />
                           </color>
                        </Stop>
                     </stops>
                  </LinearGradient>
               </ripplerFill>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </JFXButton>
         </items>
      </ToolBar>
   </top>
   <center>
      <JFXScrollPane BorderPane.alignment="CENTER">
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="160.0" prefWidth="1024.0" spacing="15.0" style="-fx-background-color: white;" stylesheets="@../css/styles.css">
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                     <children>
                        <StackPane alignment="TOP_RIGHT">
                           <children>
                              <ImageView fx:id="logoImageView" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" />
                              <Circle fx:id="statusIndicatorCircle" fill="#7aff00" radius="8.0" stroke="WHITE">
                                 <StackPane.margin>
                                    <Insets right="5.0" top="5.0" />
                                 </StackPane.margin>
                              </Circle>
                           </children>
                        </StackPane>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="restaurantNameLabel" styleClass="card-title" text="Restaurant Name" />
